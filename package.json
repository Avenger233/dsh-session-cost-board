{
  "name": "dsh-session-cost-board",
  "version": "1.0.4",
  "type": "module",
  "description": "Per-session token and money accounting for DeepSeek Harness: a settings page listing every conversation's spend plus a composer cost pill.",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cost",
    "tokens",
    "billing"
  ],
  "license": "MIT",
  "author": "Avenger233",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Avenger233/dsh-session-cost-board.git"
  },
  "homepage": "https://github.com/Avenger233/dsh-session-cost-board",
  "bugs": {
    "url": "https://github.com/Avenger233/dsh-session-cost-board/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "test": "node test/host.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "pricing.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
